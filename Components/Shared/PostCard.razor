@inject UserService UserService

<div class="card mb-2">
    <div class="card-body py-2">
        <a href="/profiles/@Post.AuthorId"><strong>@_authorName</strong></a>
        <small class="text-muted ms-2">@Post.CreatedAt.ToLocalTime().ToString("g")</small>
        @if (Post.IsDeleted)
        {
            <p class="mb-0 text-muted fst-italic">This post was deleted.</p>
        }
        else
        {
            <p class="mb-0">@Post.Content</p>
        }
        @if (CurrentUserId != null && !Post.IsDeleted)
        {
            <button class="btn btn-sm btn-link p-0" @onclick="() => OnReply.InvokeAsync(Post.Id)">Reply</button>

            @if (Post.AuthorId == CurrentUserId)
            {
                <button class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="() => OnDelete.InvokeAsync(Post.Id)">Delete</button>
            }
        }
    </div>
</div>
<div class="ms-4">
    @foreach (var reply in AllPosts.Where(p => p.ParentPostId == Post.Id))
    {
        <PostCard Post="reply" AllPosts="AllPosts" CurrentUserId="CurrentUserId" OnReply="OnReply" OnDelete="OnDelete" />
    }
</div>

@code {
    [Parameter] public required ThreadPost Post { get; set; }
    [Parameter] public int? CurrentUserId { get; set; }
    [Parameter] public EventCallback<int> OnReply { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public IReadOnlyList<ThreadPost> AllPosts { get; set; } = [];
    private string _authorName = "";

    protected override void OnParametersSet()
    {
        try
        {
            _authorName = UserService.GetProfileById(Post.AuthorId).UserName;
        }
        catch (KeyNotFoundException)
        {
            _authorName = "Former student";
        }
    }

}