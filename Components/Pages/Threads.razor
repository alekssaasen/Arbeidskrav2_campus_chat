@page "/threads"
@rendermode InteractiveServer
@inject DiscussionThreadService ThreadService
@inject CurrentUserService CurrentUserService
<h3>Threads</h3>
@if (_myThreads.Any())
{
    <h5>My threads</h5>
    <ul>
        @foreach (var thread in _myThreads)
        {
            <li><a href="/threads/@thread.Id">@thread.Title</a></li>
        }
    </ul>
}
<input class="form-control mb-3" placeholder="Search threads…"
       @bind="_searchTerm" @bind:event="oninput" @bind:after="Search" />
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
    <tr>
        <th>Title</th>
        <th>Topic</th>
        <th class="text-end">Visibility</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var thread in _threads)
    {
        <tr>
            <td class="fw-semibold">
                <a href="/threads/@thread.Id">@thread.Title</a>
            </td>
            <td>@thread.Topic</td>
            <td class="text-end">
                <span class="badge @(thread.IsPrivate ? "bg-secondary" : "bg-success")">
                    @(thread.IsPrivate ? "Private" : "Public")
                </span>
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!_threads.Any())
{
    <p>No threads match "@_searchTerm"</p>
}
@code {
    private IReadOnlyList<DiscussionThread> _threads = [];
    private string _searchTerm = "";
    private IReadOnlyList<DiscussionThread> _myThreads = [];
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUserService.RestoreProfileAsync();
            if (CurrentUserService.ProfileId != null)
            {
                _myThreads = ThreadService.GetJoinedThreads(CurrentUserService.ProfileId.Value);
            }
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        _threads = ThreadService.GetAllThreads();
    }

    public void Search()
    {
        _threads = ThreadService.SearchThreads(_searchTerm);
    }

}