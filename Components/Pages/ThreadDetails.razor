@page "/threads/{ThreadId:int}"
@inject DiscussionThreadService ThreadService
@inject ThreadPostService PostService
@inject CurrentUserService CurrentUserService
@implements IDisposable

@rendermode InteractiveServer
@if (_thread == null)
{
    <p>Thread not found.</p>
}
else
{
    @* ---------- 1. Thread info ---------- *@
    <h3>@_thread.Title</h3>
    <p class="text-muted">@_thread.Topic</p>
    <p>@_thread.Description</p>

    @* ---------- 2. Posts ---------- *@
    @if (_needsCode)
    {
        <p>This thread is private. Enter the code to read it.</p>
    }
    else if (_posts == null)
    {
        <p>Loading…</p>
    }
    else if (!_posts.Any())
    {
        <p>No posts yet. Be the first!</p>
    }
    else
    {
        @foreach (var post in _posts)
        {
            <p>@post.Content</p>
        }
    }

    @* ---------- 3. New post form ---------- *@
    @if (CurrentUserService.ProfileId == null)
    {
        <p><a href="login">Log in</a> to write a post.</p>
    }
    else if (!_needsCode)
    {
        <textarea class="form-control mb-2" @bind="_newContent" placeholder="Write a post…"></textarea>
        @if (_postError != null)
        {
            <p class="text-danger">@_postError</p>
        }
        <button class="btn btn-primary" @onclick="SubmitPost">Post</button>
    }
}

@code {
    [Parameter]
    public int ThreadId { get; set; }
    private DiscussionThread? _thread;
    private IReadOnlyList<ThreadPost>? _posts;
    private bool _needsCode;
    private string _newContent = "";
    private string? _postError;

    public void Dispose()
    {
        PostService.PostsChanged -= OnPostsChanged;
    }

    protected override void OnParametersSet()
    {
        try
        {
            _thread = ThreadService.GetThreadById(ThreadId);
        }
        catch (KeyNotFoundException)
        {
            _thread = null;
        }
    }

    private void SubmitPost()
    {
        _postError = null;
        try
        {
            PostService.CreatePost(CurrentUserService.ProfileId!.Value, ThreadId, _newContent, null, null);
            _newContent = "";
            LoadPosts();
        }
        catch (ArgumentException ex)
        {
            _postError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            _postError = ex.Message;
        }
    }
    private void LoadPosts()
    {
        if (_thread == null) return;
        try
        {
            _posts = PostService
                .GetPostsByThreadId(ThreadId, CurrentUserService.ProfileId, null)
                .ToList();
        }
        catch (UnauthorizedAccessException)
        {
            _needsCode = true; 
        }
    }

    private void OnPostsChanged(int threadId)
    {
        if (threadId != ThreadId) return;

        InvokeAsync(() =>
        {
            LoadPosts();
            StateHasChanged();
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUserService.RestoreProfileAsync();
            
            LoadPosts();
            StateHasChanged();
            PostService.PostsChanged += OnPostsChanged;
        }
    }
}