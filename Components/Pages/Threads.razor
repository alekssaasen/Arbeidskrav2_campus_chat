@page "/threads"
@rendermode InteractiveServer
@inject DiscussionThreadService ThreadService
<h3>Threads</h3>
<table class="table table-striped table-hover align-middle">
    <thead class="table-light">
    <tr>
        <th>Title</th>
        <th>Topic</th>
        <th class="text-end">Visibility</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var thread in _threads)
    {
        <tr>
            <td class="fw-semibold">@thread.Title</td>
            <td>@thread.Topic</td>
            <td class="text-end">
                <span class="badge @(thread.IsPrivate ? "bg-secondary" : "bg-success")">
                    @(thread.IsPrivate ? "Private" : "Public")
                </span>
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private List<DiscussionThread> _threads = new();

    protected override void OnInitialized()
    {
        _threads = ThreadService.GetAllThreads();
    }

}