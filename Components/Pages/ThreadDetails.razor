@page "/threads/{ThreadId:int}"
@inject DiscussionThreadService ThreadService
@inject ThreadPostService PostService
@inject CurrentUserService CurrentUserService
@inject ProtectedSessionStorage SessionStorage

@rendermode InteractiveServer
<h3>ThreadDetails</h3>
@if (_thread != null)
{
    <p>@_thread.Title</p>
    <p>@_thread.Topic</p>
    <p>@_thread.Description</p>
}
else
{
    <p>Thread not found.</p>
}
@if (_needsCode)
{
    <p>This thread is private. Enter the code to read it.</p>
}
else if (_posts == null)
{
    <p>Loading…</p>
}
else if (!_posts.Any())
{
    <p>No posts yet. Be the first!</p>
}
else
{
    @foreach (var post in _posts)
    {
        <p>@post.Content</p>
    }
}

@code {
    [Parameter]
    public int ThreadId { get; set; }
    private DiscussionThread? _thread;
    private IEnumerable<ThreadPost>? _posts;
    private bool _needsCode;


    protected override void OnParametersSet()
    {
        try
        {
            _thread = ThreadService.GetThreadById(ThreadId);
        }
        catch (KeyNotFoundException)
        {
            _thread = null;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUserService.RestoreProfileAsync();
            if (CurrentUserService.ProfileId != null)
            {
                int profileId = CurrentUserService.ProfileId.Value;
                try
                {
                    _posts = PostService
                        .GetPostsByThreadId(ThreadId, profileId, null)
                        .ToList();
                }
                catch (UnauthorizedAccessException)
                {
                    _needsCode = true;
                }
            }
            StateHasChanged();
        }
    }
}