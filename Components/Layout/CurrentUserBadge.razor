@rendermode InteractiveServer
@inject CurrentUserService CurrentUserService
@inject UserService UserService
@implements IDisposable
@if (!CurrentUserService.IsLoaded)
{
    <p>Loading...</p>
} else if (_userName == null)
{
    <a href="login">Login</a>
}
else
{
    <p>Logged in as <strong>@_userName</strong></p>
}



@code {
    private string? _userName;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUserService.RestoreProfileAsync();
            LoadUserName();
            CurrentUserService.ProfileChanged += OnProfileChanged;
            StateHasChanged();
        }
    }
    
    private void OnProfileChanged()
    {
        InvokeAsync(() =>
        {
            LoadUserName();
            StateHasChanged();
        });
    }
    private void LoadUserName()
    {
        try
        {
            _userName = null;
            if (CurrentUserService.ProfileId.HasValue)
            {
                _userName = UserService.GetProfileById(CurrentUserService.ProfileId.Value).UserName;
            }
        }
        catch (KeyNotFoundException)
        {
            _userName = null;
        }
    }

    public void Dispose()
    {
        CurrentUserService.ProfileChanged -= OnProfileChanged;
    }
}