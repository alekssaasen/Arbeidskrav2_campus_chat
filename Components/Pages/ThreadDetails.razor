@page "/threads/{ThreadId:int}"
@inject DiscussionThreadService ThreadService
@inject ThreadPostService PostService
@inject CurrentUserService CurrentUserService
@implements IDisposable

@rendermode InteractiveServer
@if (_thread == null)
{
    <p>Thread not found.</p>
}
else
{
    @* ---------- 1. Thread info ---------- *@
    <h3>@_thread.Title</h3>
    <p class="text-muted">@_thread.Topic</p>
    <p>@_thread.Description</p>
    @if (CurrentUserService.ProfileId != null && !_needsCode && _posts != null)
    {
        @if (_isMember)
        {
            <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="HandleLeave">Leave thread</button>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm mb-3" @onclick="HandleJoin">Join thread</button>
        }
    }

    @* ---------- 2. Posts ---------- *@
    
    @if (_needsCode)
    {
        <p>This thread is private. Enter the code to read it.</p>
        @if (CurrentUserService.ProfileId == null)
        {
            <p><a href="login">Log in</a> to enter a code.</p>
        }
        else
        {
            <input class="form-control mb-2" @bind="_accessCode" placeholder="Access code" />
            @if (_codeError != null)
            {
                <p class="text-danger">@_codeError</p>
            }
            <button class="btn btn-primary" @onclick="SubmitCode">Unlock</button>
        }
    }
    else if (_posts == null)
    {
        <p>Loading…</p>
    }
    else if (!_posts.Any())
    {
        <p>No posts yet. Be the first!</p>
    }
    else
    {
        @foreach (var post in _posts.Where(p => p.ParentPostId == null))
        {
            <PostCard Post="post" AllPosts="_posts" CurrentUserId="CurrentUserService.ProfileId" OnReply="StartReply" OnDelete="HandleDeletePost" />
        }
    }

    @* ---------- 3. New post form ---------- *@
    @if (CurrentUserService.ProfileId == null)
    {
        <p><a href="login">Log in</a> to write a post.</p>
    }
    else if (!_needsCode)
    {
        if (_replyToId != null)
        {
            <p class="small mb-1">
                Replying to a post
                <button class="btn btn-sm btn-link p-0 ms-2" @onclick="CancelReply">Cancel</button>
            </p>
        }
        <textarea class="form-control mb-2" @bind="_newContent" placeholder="Write a post…"></textarea>
        @if (_postError != null)
        {
            <p class="text-danger">@_postError</p>
        }
        <button class="btn btn-primary" @onclick="SubmitPost">Post</button>
    }
}

@code {
    [Parameter]
    public int ThreadId { get; set; }
    private DiscussionThread? _thread;
    private IReadOnlyList<ThreadPost>? _posts;
    private bool _needsCode;
    private string _newContent = "";
    private string? _postError;
    private int? _replyToId;
    private string _accessCode = "";
    private string? _codeError;
    private bool _isMember;

    public void Dispose()
    {
        PostService.PostsChanged -= OnPostsChanged;
    }

    protected override void OnParametersSet()
    {
        try
        {
            _thread = ThreadService.GetThreadById(ThreadId);
        }
        catch (KeyNotFoundException)
        {
            _thread = null;
        }
    }
    
    private void OnPostsChanged(int threadId)
    {
        if (threadId != ThreadId) return;

        InvokeAsync(() =>
        {
            LoadPosts();
            StateHasChanged();
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CurrentUserService.RestoreProfileAsync();
            
            LoadPosts();
            StateHasChanged();
            PostService.PostsChanged += OnPostsChanged;
        }
    }

    private void SubmitPost()
    {
        _postError = null;
        try
        {
            PostService.CreatePost(CurrentUserService.ProfileId!.Value, ThreadId, _newContent, _replyToId, _accessCode);
            _newContent = "";
            _replyToId = null;
            LoadPosts();
        }
        catch (ArgumentException ex)
        {
            _postError = ex.Message;
        }
        catch (UnauthorizedAccessException ex)
        {
            _postError = ex.Message;
        }
    }
    private void SubmitCode()
    {
        _codeError = null;
        LoadPosts();
        if (_needsCode)
        {
            _codeError = "Wrong code.";
        }
    }
    private void LoadPosts()
    {
        if (_thread == null) return;
        try
        {
            _posts = PostService
                .GetPostsByThreadId(ThreadId, CurrentUserService.ProfileId, _accessCode)
                .ToList();
            _needsCode = false;
            _isMember = CurrentUserService.ProfileId != null && ThreadService.IsMember(CurrentUserService.ProfileId.Value, ThreadId);
        }
        catch (UnauthorizedAccessException)
        {
            _needsCode = true; 
        }
    }

    private void HandleDeletePost(int postId)
    {
        _postError = null;
        try
        {
            PostService.DeletePost(postId, CurrentUserService.ProfileId!.Value);
        }
        catch (UnauthorizedAccessException ex)
        {
            _postError = ex.Message;
        }
    }
    
    private void StartReply(int postId)
    {
        _replyToId = postId;
    }
    
    private void CancelReply()
    {
        _replyToId = null;
    }

    private void HandleJoin()
    {
        _postError = null;
        try
        {
            ThreadService.JoinThread(CurrentUserService.ProfileId!.Value, ThreadId, _accessCode);
            _isMember = true;
        }
        catch (UnauthorizedAccessException ex)
        {
            _postError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _postError = ex.Message;
        }
    }
    
    private void HandleLeave()
    {
        _postError = null;
        try
        {
            ThreadService.LeaveThread(CurrentUserService.ProfileId!.Value, ThreadId);
            _isMember = false;
        }
        catch (UnauthorizedAccessException ex)
        {
            _postError = ex.Message;
        }
        catch (ArgumentException ex)
        {
            _postError = ex.Message;
        }
        LoadPosts();
    }
}