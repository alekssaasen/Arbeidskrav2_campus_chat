@page "/login"
@rendermode InteractiveServer

@inject UserService UserService
@inject CurrentUserService CurrentUserService
@inject NavigationManager Navigation
<h3>Sign in</h3>
<select @bind="_selectedProfileId">
    <option value="0">Select a profile</option>
    @foreach (var profile in _profiles)
    {
        <option value="@profile.Id">@profile.UserName</option>
    }
</select>

<button @onclick="SignIn">Sign in</button>
<p class="mt-2">New here? <a href="/profiles/new">Create a profile</a></p>


@code {
    private IReadOnlyList<Profile> _profiles = [];
    private int _selectedProfileId;

    protected override void OnInitialized()
    {
        _profiles = UserService.GetAllProfiles();
    }

    private async Task SignIn()
    {
        var user = _profiles.FirstOrDefault(t => t.Id == _selectedProfileId);
        if (user == null)
        {
            return;
        }
        await CurrentUserService.SetProfileAsync(user.Id);
        Navigation.NavigateTo("/threads");
    }
}